<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.eatkfcinmc.better-orpheus</id>

  <name>Better Orpheus</name>
  <summary>Netease Cloud Music for Linux</summary>
  <summary xml:lang="zh-CN">Linux 版网易云音乐客户端</summary>
  <developer_name>EatKFCinMc</developer_name>
  <developer id="io.github.eatkfcinmc">
    <name translate="no">EatKFCinMc</name>
  </developer>
  <url type="homepage">https://github.com/EatKFCinMc/better-orpheus</url>
  <url type="vcs-browser">https://github.com/EatKFCinMc/better-orpheus</url>
  <url type="bugtracker">https://github.com/EatKFCinMc/better-orpheus/issues</url>
  <url type="contact">https://github.com/EatKFCinMc/better-orpheus/discussions</url>
  <url type="contribute">https://github.com/EatKFCinMc/better-orpheus/blob/main/CONTRIBUTING.md</url>

  <metadata_license>CC-BY-4.0</metadata_license>
  <project_license>GPL-3.0</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>tablet</control>
  </supports>

  <description>
    <p>**This app is only available in Chinese.**</p>
    <p>
      Open Orpheus is an open-source implementation of Netease Cloud Music browser host, it allows the user to run Netease Cloud Music official client's web resources on Linux, with the best compatibility provided by this host.
    </p>
    <p xml:lang="zh-CN">**本应用当前仅提供中文界面。**</p>
    <p xml:lang="zh-CN">
      Better Orpheus 是网易云音乐浏览器宿主的开源实现，并且加入了 BetterNCM 兼容层，让用户可以在 Linux 上运行网易云音乐官方客户端的网页资源，并提供尽可能好的兼容性。
    </p>
  </description>

  <launchable type="desktop-id">io.github.eatkfcinmc.better-orpheus.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#5A9EF5</color>
    <color type="primary" scheme_preference="dark">#2B4A73</color>
  </branding>

  <screenshots>
