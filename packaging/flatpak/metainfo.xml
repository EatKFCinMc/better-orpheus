    </screenshot>
    <screenshot>
      <caption>Player view</caption>
      <caption xml:lang="zh-CN">播放器界面</caption>
      <image>https://raw.githubusercontent.com/EatKFCinMc/better-orpheus/main/assets/screenshots/2.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings and customization</caption>
      <caption xml:lang="zh-CN">设置与个性化</caption>
      <image>https://raw.githubusercontent.com/EatKFCinMc/better-orpheus/main/assets/screenshots/3.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-11-03">
      <url type="details">https://github.com/EatKFCinMc/better-orpheus/releases/tag/v0.1.0</url>
      <description>
        <p>Initial release of the fork.</p>
        <p xml:lang="zh-CN">分支的首次发布。</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1">
