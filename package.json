{
  "name": "better-orpheus",
  "productName": "better-orpheus",
  "version": "0.1.0",
  "description": "An open-source implementation of Netease Cloud Music's Orpheus browser host with BetterNCM compatibility layer.",
  "type": "module",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build:modules": "node scripts/build-modules.ts",
    "start": "pnpm build:betterncm && electron-forge start",
    "package": "pnpm build:betterncm && electron-forge package",
    "make": "pnpm build:betterncm && electron-forge make",
    "make:srpm": "node scripts/build-srpm.ts",
    "make:rpm": "node scripts/build-rpm.ts",
    "make:deb-src": "node scripts/build-deb-src.ts",
    "make:deb": "node scripts/build-deb.ts",
    "publish": "electron-forge publish",
    "lint": "pnpm lint:oxlint && pnpm lint:gui",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:gui": "pnpm lint:gui:eslint && pnpm lint:gui:check",
    "lint:gui:eslint": "pnpm --dir gui lint",
    "lint:gui:check": "pnpm --dir gui check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "build:betterncm": "node scripts/build-betterncm.ts"
  },
  "homepage": "https://github.com/EatKFCinMc/better-orpheus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EatKFCinMc/better-orpheus.git"
  },
  "bugs": {
    "url": "https://github.com/EatKFCinMc/better-orpheus/issues"
  },
  "keywords": [],
  "author": {
    "name": "EatKFCinMc",
    "email": "mayoad451@gmail.com"
  },
  "contributors": [
    {
      "name": "YUCLing"
    },
    {
      "name": "std-microblock"
    }
  ],
  "license": "GPL-3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/core": "^8.0.1",
